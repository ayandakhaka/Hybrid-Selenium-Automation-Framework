[
  {
    "name": "Product Defect",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*AssertionError.*|.*expected.*but.*actual.*"
  },
  {
    "name": "Automation Defect",
    "matchedStatuses": ["broken"],
    "traceRegex": ".*NoSuchElementException.*|.*NullPointerException.*|.*WebDriverException.*"
  },
  {
    "name": "Infrastructure Failure",
    "matchedStatuses": ["broken"],
    "traceRegex": ".*Connection refused.*|.*Connection reset.*|.*UnknownHostException.*|.*SSLHandshakeException.*"
  },
  {
    "name": "Timeout Failure",
    "matchedStatuses": ["broken"],
    "traceRegex": ".*TimeoutException.*|.*timeout.*"
  }
]