[
  {
    "name": "API Failures",
    "matchedStatuses": [
      "failed"
    ],
    "messageRegex": ".*(success status code|responseCode|API|HTTP|RestAssured).*"
  },
  {
    "name": "Assertion Failures",
    "matchedStatuses": [
      "failed"
    ],
    "messageRegex": ".*(expected.*but found|Failed to verify success message body).*"
  },
  {
    "name": "UI Element Failures",
    "matchedStatuses": [
      "broken"
    ],
    "messageRegex": ".*(NoSuchElementException|ElementNotInteractableException|ElementClickInterceptedException).*"
  },
  {
    "name": "Timeout Failures",
    "matchedStatuses": [
      "broken"
    ],
    "messageRegex": ".*(TimeoutException|Expected condition failed).*"
  },
  {
    "name": "WebDriver Failures",
    "matchedStatuses": [
      "broken"
    ],
    "messageRegex": ".*(WebDriverException|SessionNotCreatedException|Driver).*"
  }
]