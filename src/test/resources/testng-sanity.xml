<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Sanity Test Suite">

    <test name="UI and API Sanity Tests">

        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>

        <packages>
            <package name="ui.tests"/>
            <package name="api.tests"/>
        </packages>

    </test>

</suite>